<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Crystal.Common</RootNamespace>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0">
      <Aliases>Crypt</Aliases>
    </PackageReference>
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MiniGame\Packets\NewFolder\" />
  </ItemGroup>

  <!-- SqCryptoKeys.Local.cs (gitignored) holds the real keys and replaces the placeholder file -->
  <ItemGroup Condition="Exists('SqCryptoKeys.Local.cs')">
    <Compile Remove="SqCryptoKeys.cs" />
  </ItemGroup>

</Project>
